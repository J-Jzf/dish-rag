# LLM 使用 OpenAI-compatible 的 Chat Completions 接口。
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# Embedding 使用 OpenAI-compatible 的 Embeddings 接口。
EMBEDDING_MODEL_ID=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Rerank 使用 OpenAI-compatible 或常见 HTTP rerank 接口。
RERANK_MODEL_ID=
RERANK_API_KEY=
RERANK_BASE_URL=

# Qdrant 默认使用嵌入式本地存储。
# QDRANT_URL 留空时使用 QDRANT_PATH。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=dish_recipes
QDRANT_PATH=var/qdrant

# 本地持久化存储。
SQLITE_PATH=var/dish_rag.sqlite3
LANGGRAPH_CHECKPOINT_DB=var/langgraph_checkpoints.sqlite3

# 知识库构建默认配置。
PDF_PATH=data/菜谱_230道.pdf
BUILD_DIR=build
LOW_CONFIDENCE_THRESHOLD=0.78
